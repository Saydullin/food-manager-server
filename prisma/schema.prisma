// Prisma schema for the Food Manager backend.
// Auth model: device public-key (passkey-style). Email is OPTIONAL, for recovery only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A user account. Identified by username; email is optional and only used for recovery.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @unique
  // Nullable: email is opt-in. Partial-unique behavior (unique only when present)
  // is provided by Postgres treating multiple NULLs as distinct on a UNIQUE column.
  email         String?  @unique
  emailVerified Boolean  @default(false)
  // Optional profile picture. Stores an http(s) URL to the image (the client uploads
  // the file elsewhere and sends the URL), mirroring how Food.imageUrl works. Null
  // means no picture is set — the default after registration.
  imageUrl      String?
  // Free-form, user-editable profile fields. All optional (null after registration)
  // and edited via PATCH /users/me. `name` is a display name (distinct from the
  // unique login `username`); `status` is a short one-liner; `description` is the
  // longer "about me". `age` is stored as a whole number of years.
  name          String?
  age           Int?
  status        String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // When this account finished (or explicitly declined) the app's onboarding
  // questions. Null means it has never been asked. Scoped to the account rather than
  // the install so the questions are asked exactly once per user, ever: a device-local
  // flag would re-ask after every logout and after every reinstall, and would also
  // wrongly skip the questions for a *different* account signing in on the same phone.
  // A timestamp rather than a boolean because "when" is free to store and useful later;
  // the API exposes only the derived boolean.
  onboardingCompletedAt DateTime?

  // Moderation: an admin-suspended account. Does not revoke existing sessions/
  // tokens on its own — that would be a separate follow-up if ever needed.
  isBanned Boolean   @default(false)
  bannedAt DateTime?

  devices                 Device[]
  challenges              Challenge[]
  refreshTokens           RefreshToken[]
  recoveryTokens          RecoveryToken[]
  emailVerificationTokens EmailVerificationToken[]
  foodPreferences         UserFoodPreference[]
  foodExceptions          UserFoodException[]
  diets                   UserDiet[]
  settings                UserSettings?
  foodInteractions        FoodInteraction[]
  complaintsFiled         Complaint[]              @relation("ComplaintReporter")
  complaintsAgainst       Complaint[]              @relation("ComplaintTargetUser")

  @@map("users")
}

/// An admin-panel account (email + password login), entirely separate from the
/// device-key auth used by the mobile app's `User` model — different threat model
/// (browser session vs. mobile passkey), so it gets its own table, secret and
/// middleware rather than reusing User + a role flag.
model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resolvedComplaints Complaint[]

  @@map("admin_users")
}

/// A single free-form food preference the user filled in (e.g. "spicy", "italian").
/// One row per (user, value); the full preference list is these rows for a user.
/// Values are stored trimmed + lowercased so the unique constraint dedupes
/// case-insensitively ("Spicy" and "spicy" collapse to one row).
model UserFoodPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, value])
  @@index([userId])
  @@map("user_food_preferences")
}

/// A single free-form food exception the user dislikes / wants avoided
/// (e.g. "cilantro", "mushrooms"). Same shape and normalization rules as
/// UserFoodPreference — just the opposite intent.
model UserFoodException {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())

  @@unique([userId, value])
  @@index([userId])
  @@map("user_food_exceptions")
}

/// The fixed, server-owned catalog of selectable diets. Unlike food preferences,
/// this list is NOT user-authored — it is the source of truth for the valid diet
/// codes a client may send. `code` is a stable machine-readable enum (e.g.
/// "VEGETARIAN"); the client maps it to a localized display name. Seeded with a
/// default set; new diets can be added later (e.g. from an admin panel) by simply
/// inserting rows — no enum change or code deploy required.
/// NB: distinct from `FoodDiets`, which is per-dish diet-compliance flags.
model Diet {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  // Presentation order for the catalog; admin-controllable, ties broken by code.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserDiet[]

  @@map("diets")
}

/// Join table: the diets a user has selected. References both the users table and
/// the diet catalog, so a selection can never point at a non-existent diet, and a
/// user has at most one row per diet.
model UserDiet {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietId    String   @db.Uuid
  diet      Diet     @relation(fields: [dietId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, dietId])
  @@index([userId])
  @@index([dietId])
  @@map("user_diets")
}

/// The UI theme the client should render in. SYSTEM defers to the device's OS
/// setting (the client resolves it to light/dark at render time); LIGHT/DARK pin
/// it explicitly. Modeled as an enum since the set is fixed — unlike the diet
/// catalog, new values here are a deliberate schema change, not runtime data.
enum Theme {
  LIGHT
  DARK
  SYSTEM
}

/// Per-user client-side preferences (language, theme, push notifications), one
/// row per user (1:1). Kept in its own table rather than as columns on User so
/// new settings can be added without touching the core account row — the same
/// concern-splitting the Food* tables apply to Food. A default row is created at
/// registration; reads fall back to the column defaults if a row is ever missing.
model UserSettings {
  userId                   String   @id @db.Uuid
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // BCP-47 language tag the client renders in (e.g. "en", "ru", "en-US").
  language                 String   @default("en")
  theme                    Theme    @default(SYSTEM)
  pushNotificationsEnabled Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("user_settings")
}

/// A registered device, holding the public half of the device keypair.
/// The private key never leaves the Android Keystore.
model Device {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Base64-encoded SubjectPublicKeyInfo (DER) for an Ed25519 or RSA public key.
  publicKey   String   @unique
  deviceLabel String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

/// Short-lived, single-use login challenge. The client signs `nonce` with its
/// device private key; the server verifies the signature against the device public key.
model Challenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nonce     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("challenges")
}

/// Long-lived refresh token. Only the hash is stored; the raw token is returned once.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String   @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

/// Single-use, email-delivered proof that lets a user link a NEW device public key
/// to their existing account after losing their old device. Requires a verified email.
/// Carries two independent proofs, either of which authorizes the same recovery:
///  - a long opaque LINK token (`tokenHash`), used by /recovery/request + /recovery/confirm; and
///  - a short numeric CODE (`codeHash`), used by /recovery/request-code + /recovery/confirm-code,
///    which backs "log in / restore access by username + email" on a fresh device.
/// A given row uses exactly one of the two (the other stays null), so `tokenHash` is nullable.
model RecoveryToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Link-token path. Nullable because code-only recovery rows carry no link; Postgres
  // treats multiple NULLs as distinct on a UNIQUE column, so this stays @unique.
  tokenHash     String?   @unique
  expiresAt     DateTime
  // Short numeric code path (email-code login / restore access). Hashed at rest like tokenHash.
  codeHash      String?
  codeExpiresAt DateTime?
  // Failed-attempt counter — a 4-digit code has a tiny keyspace, so this bounds guessing.
  codeAttempts  Int       @default(0)
  used          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("recovery_tokens")
}

/// Single-use, email-delivered token that verifies ownership of an email address.
/// (Not in the original spec's table list, but needed to back the /email/verify endpoint.)
/// Carries two independent proofs of the same pending (userId, email) pair: a long
/// opaque link token (tokenHash) and a short numeric code (codeHash) for apps that
/// can't open a deep link. Either one verifies the email; both share `used`/`email`.
model EmailVerificationToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The email this token verifies (so changing email invalidates old links naturally).
  email         String
  tokenHash     String    @unique
  expiresAt     DateTime
  // Short numeric code, delivered in the same email as the link. Hashed at rest like
  // tokenHash. Nullable so pre-migration rows (link-only) remain valid.
  codeHash      String?
  codeExpiresAt DateTime?
  // Failed-attempt counter, since a 4-digit code has a much smaller keyspace than the
  // link token — this bounds brute-force guesses before the code is invalidated.
  codeAttempts  Int       @default(0)
  used          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// Food domain
// ---------------------------------------------------------------------------

/// The core dish/recipe table. Deliberately has no FK to any "dependent" table
/// (a table that itself references Food, e.g. likes, nutrition, tags) — those
/// tables point at Food, never the other way. FKs from Food to terminal tables
/// (images, extended details, etc.) would be fine since nothing depends on them,
/// but none are modeled yet since none were requested.
model Food {
  id          String   @id @default(uuid()) @db.Uuid
  // Legacy single "cover" image. The 1..7-image gallery lives in FoodImage; this
  // stays as an optional cover/fallback (the API's `images` array falls back to it
  // when the food has no FoodImage rows yet).
  imageUrl    String?
  // The dish's cuisine, as a FK into the server-owned Cuisine catalog. Nullable —
  // a dish may be uncategorized. This is a FK to a *terminal* reference table
  // (nothing depends on Food through it), which the food_table.md rule allows.
  cuisineId   String?  @db.Uuid
  cuisine     Cuisine? @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Per-language name/description. Language-agnostic data (cuisine, nutrition,
  // allergens, images) stays directly on Food so it isn't duplicated per
  // language; only the text content is translated.
  translations        FoodTranslation[]
  allergens           FoodAllergens?
  dietaryRestrictions FoodDietaryRestrictions?
  intolerances        FoodIntolerances?
  features            FoodFeatures?
  diets               FoodDiets?
  nutrition           FoodNutrition?
  images              FoodImage[]
  interactions        FoodInteraction[]
  complaints          Complaint[]
  ingredients         FoodIngredient[]

  // The feed pages by (createdAt, id) and excludes already-swiped dishes; this
  // composite index keeps that ordered scan efficient.
  @@index([createdAt, id])
  @@index([cuisineId])
  @@map("foods")
}

/// A dish's name/description in one language. A dish has one row per supported
/// language (at least one, its "default" language); the client requests a
/// `lang` and the server falls back to the default when a translation is
/// missing, so a partially-translated catalog never 404s.
model FoodTranslation {
  id     String @id @default(uuid()) @db.Uuid
  foodId String @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  // BCP-47 language tag (e.g. "en", "ru"), same convention as UserSettings.language.
  language    String
  name        String
  description String?
  // The recipe's full article body (instructions/steps) for this language,
  // authored via the admin panel's rich-text editor. Stored as HTML. Separate
  // from `description` (a short blurb) the same way a blog post's excerpt
  // differs from its body.
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([foodId, language])
  @@index([foodId])
  @@map("food_translations")
}

/// Allergen tags for a dish. One row per food, one boolean column per allergen.
model FoodAllergens {
  foodId String @id @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  milk      Boolean @default(false)
  eggs      Boolean @default(false)
  peanuts   Boolean @default(false)
  treeNuts  Boolean @default(false)
  soy       Boolean @default(false)
  wheat     Boolean @default(false)
  gluten    Boolean @default(false)
  fish      Boolean @default(false)
  shellfish Boolean @default(false)
  sesame    Boolean @default(false)
  mustard   Boolean @default(false)
  celery    Boolean @default(false)
  lupin     Boolean @default(false)
  molluscs  Boolean @default(false)
  sulfites  Boolean @default(false)

  @@map("food_allergens")
}

/// Dietary-restriction compliance tags for a dish (does it fit the diet, not "does it contain X").
model FoodDietaryRestrictions {
  foodId String @id @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  vegetarian  Boolean @default(false)
  vegan       Boolean @default(false)
  pescatarian Boolean @default(false)
  halal       Boolean @default(false)
  kosher      Boolean @default(false)

  @@map("food_dietary_restrictions")
}

/// Intolerance tags for a dish. Distinct from allergens (medically different
/// mechanism), so kept as its own table even where terms overlap (e.g. gluten).
model FoodIntolerances {
  foodId String @id @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  lactose   Boolean @default(false)
  gluten    Boolean @default(false)
  fructose  Boolean @default(false)
  histamine Boolean @default(false)

  @@map("food_intolerances")
}

/// Dish characteristic tags (spice level, macro-leaning descriptors).
model FoodFeatures {
  foodId String @id @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  spicy       Boolean @default(false)
  verySpicy   Boolean @default(false)
  lowCarb     Boolean @default(false)
  highProtein Boolean @default(false)
  lowFat      Boolean @default(false)
  lowCalorie  Boolean @default(false)
  highFiber   Boolean @default(false)
  highSugar   Boolean @default(false)
  highSodium  Boolean @default(false)
  sweet       Boolean @default(false)
  sugarFree   Boolean @default(false)

  @@map("food_features")
}

/// Named-diet compliance tags for a dish.
model FoodDiets {
  foodId String @id @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  keto             Boolean @default(false)
  paleo            Boolean @default(false)
  mediterranean    Boolean @default(false)
  diabeticFriendly Boolean @default(false)
  lowGi            Boolean @default(false)

  @@map("food_diets")
}

/// Per-serving nutrition for a dish. One row per food (1:1). Split out of Food so
/// the core dish row stays lean and nutrition can grow (protein/fat/carbs — КБЖУ)
/// without touching Food, mirroring how the tag tables are separated. All fields
/// nullable — a dish may be listed before its nutrition is filled in.
model FoodNutrition {
  foodId String @id @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  // Energy per serving, in kilocalories.
  calories Int?
  // How many servings the dish yields.
  servings Int?
  // КБЖУ macros per serving, in grams. Optional; here so future recommendation
  // scoring can use them without another migration.
  protein  Float?
  fat      Float?
  carbs    Float?

  @@map("food_nutrition")
}

/// An image in a dish's gallery. A dish has 1..7 of these (the 7-image cap is
/// enforced at write time, not by the DB). `position` orders the gallery; the
/// first (lowest position) doubles as the cover. Terminal table — it references
/// Food, nothing references it.
model FoodImage {
  id        String   @id @default(uuid()) @db.Uuid
  foodId    String   @db.Uuid
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  url       String
  // 0-based display order within the dish's gallery. Unique per dish so two images
  // can't claim the same slot.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([foodId, position])
  @@index([foodId])
  @@map("food_images")
}

/// The catalog of selectable ingredients (e.g. "Tomato", "Olive oil"). Unlike
/// Diet/Cuisine, this is authored ad hoc from the admin recipe form itself (an
/// admin can type a new ingredient name inline while building a recipe), not
/// pre-seeded — so it has no fixed `code`, just a user-authored name per
/// language (see IngredientTranslation). Shared across recipes: one row per
/// distinct ingredient, referenced by many FoodIngredient rows.
model Ingredient {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations    IngredientTranslation[]
  foodIngredients FoodIngredient[]

  @@map("ingredients")
}

/// An ingredient's name in one language. Mirrors FoodTranslation exactly — an
/// ingredient has one row per language it's been named in (at least one), and
/// reads fall back the same way (requested language -> default language ->
/// whatever exists), so a partially-translated catalog never breaks a recipe read.
model IngredientTranslation {
  id           String     @id @default(uuid()) @db.Uuid
  ingredientId String     @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  // BCP-47 language tag, same convention as FoodTranslation.language.
  language     String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ingredientId, language])
  @@index([ingredientId])
  // Backs both the admin search-by-name-in-any-language query and the
  // resolveIngredientId "same name, same language" reuse lookup.
  @@index([language, name])
  @@map("ingredient_translations")
}

/// One line of a recipe's ingredient list: a catalog ingredient plus how much
/// of it the recipe uses. `unit` is free-text (e.g. "g", "ml", "pcs") rather
/// than an enum since recipes reasonably mix weight/volume/count units.
/// `position` preserves the admin-authored ordering, same convention as
/// FoodImage.position. Terminal table — references Food and Ingredient,
/// nothing references it.
model FoodIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  foodId       String     @db.Uuid
  food         Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  ingredientId String     @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  amount       Float
  unit         String     @default("g")
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  // One line per (recipe, ingredient) — re-adding the same ingredient updates
  // its amount/unit instead of duplicating the row.
  @@unique([foodId, ingredientId])
  @@index([foodId])
  @@index([ingredientId])
  @@map("food_ingredients")
}

/// The server-owned catalog of cuisines a dish can belong to (e.g. "ITALIAN").
/// Same pattern as Diet: NOT user-authored, `code` is a stable machine-readable
/// enum the client maps to a localized name, and new cuisines are added by
/// inserting rows — no enum change or code deploy. Referenced by Food.cuisineId.
model Cuisine {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  // Presentation order for the catalog; admin-controllable, ties broken by code.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foods Food[]

  @@map("cuisines")
}

/// What a swipe means. A fixed, code-level set (like Theme), so modeled as an enum
/// rather than a catalog table: adding a value is a deliberate schema + code change.
enum FoodInteractionAction {
  LIKE
  SKIP
  DISLIKE
}

/// Why a user hit "Hate it" on a dish. Only meaningful when action = DISLIKE.
/// DISLIKE_TAG / WRONG_CUISINE carry the specific tag/cuisine code in
/// FoodInteraction.reasonDetail; the rest stand alone. These are the raw negative
/// signals the future recommender learns from.
enum FoodDislikeReason {
  DISLIKE_TAG
  WRONG_CUISINE
  ALREADY_ATE
  ALLERGEN
  NOT_IN_MOOD
  OTHER
}

/// One user's verdict on one dish — the swipe. At most one row per (user, dish):
/// re-swiping updates it (an upsert), so this table also doubles as the "already
/// seen" set the feed subtracts. This is the primary training signal for the
/// future preference-based recommender, which is why the dislike reason/detail are
/// captured, not just the like/skip.
model FoodInteraction {
  id     String                @id @default(uuid()) @db.Uuid
  userId String                @db.Uuid
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId String                @db.Uuid
  food   Food                  @relation(fields: [foodId], references: [id], onDelete: Cascade)
  action FoodInteractionAction

  // Populated only for DISLIKE. `reasonDetail` holds the specific tag code
  // ("SPICY", "MILK", ...) for DISLIKE_TAG, or a cuisine code for WRONG_CUISINE.
  reason       FoodDislikeReason?
  reasonDetail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One verdict per (user, dish); also the lookup the feed uses to exclude seen dishes.
  @@unique([userId, foodId])
  // "My likes/dislikes" list: filter by user + action, newest first.
  @@index([userId, action, createdAt])
  // Correlated subquery in the feed excludes dishes this user has already swiped.
  @@index([foodId, userId])
  @@map("food_interactions")
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

/// What kind of thing a complaint targets. Determines which of
/// `targetUserId`/`targetFoodId` on Complaint is populated.
enum ComplaintTargetType {
  USER
  FOOD
}

enum ComplaintStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A user-filed report against another user or a dish, moderated by an admin.
/// Exactly one of `targetUserId`/`targetFoodId` is set, matching `targetType` —
/// enforced in the service layer (same style as FoodInteraction's reason/
/// reasonDetail pairing), not a DB constraint, since Prisma has no native
/// polymorphic-FK / exactly-one-of-N-columns check.
model Complaint {
  id         String              @id @default(uuid()) @db.Uuid
  reporterId String              @db.Uuid
  reporter   User                @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ComplaintTargetType

  targetUserId String? @db.Uuid
  targetUser   User?   @relation("ComplaintTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetFoodId String? @db.Uuid
  targetFood   Food?   @relation(fields: [targetFoodId], references: [id], onDelete: Cascade)

  reason String
  status ComplaintStatus @default(OPEN)

  resolvedByAdminId String?    @db.Uuid
  resolvedByAdmin   AdminUser? @relation(fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([targetFoodId])
  @@map("complaints")
}
