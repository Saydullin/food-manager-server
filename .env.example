# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed by CORS. Use * only in development.
CORS_ORIGIN=*

# Base URL used when building email links (verification / recovery).
# In production this is your public API/base domain.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_manager?schema=public"

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Use long, random, DIFFERENT values for these two. e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Access token lifetime (short-lived). Accepts vercel/ms style: 15m, 1h, 900s
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime (long-lived).
REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Auth timing (all in SECONDS)
# ---------------------------------------------------------------------------
# Login challenge / nonce lifetime. Spec: 2 minutes.
CHALLENGE_TTL=120
# Email-based recovery link lifetime. Spec: 30 minutes.
RECOVERY_TOKEN_TTL=1800
# Email verification link lifetime.
EMAIL_VERIFICATION_TTL=86400
# Email verification CODE lifetime (short, since it's meant to be typed in right away).
EMAIL_CODE_TTL=600
# Failed-attempt limit for the verification code before it's rejected outright.
EMAIL_CODE_MAX_ATTEMPTS=5
# Login / restore-access CODE lifetime (username + email flow). Short, like the
# verification code — it's meant to be typed in right away.
RECOVERY_CODE_TTL=600
# Failed-attempt limit for the login/recovery code before it's rejected outright.
RECOVERY_CODE_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# SMTP (email delivery)
# Not wired up yet — recovery/verification links are logged to the console.
# These are placeholders for when real email sending is enabled.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Food Manager <no-reply@example.com>"
